# ============================================================
# SALIN FILE INI MENJADI `.env` LALU SESUAIKAN NILAINYA
#   cp .env.example .env
# Setelah mengubah nilai, jalankan ulang:  npm run dev
# (mode produksi: build ulang dengan  npm run build)
# ============================================================

# ---------- DATABASE ----------
# SQLite. Path relatif ditulis dari folder prisma/ (jadi ../db = folder db di akar proyek)
DATABASE_URL="file:../db/custom.db"
# Di Vercel (demo): ganti menjadi  DATABASE_URL="file:/tmp/custom.db"
# — tabel & akun admin dibuat otomatis saat server pertama nyala
# (lihat src/lib/bootstrap-db.ts). Data bersifat sementara di Vercel.

# ---------- IDENTITAS APLIKASI (nama yang bisa diganti) ----------
# Semua opsional — kosongkan untuk memakai bawaan.
# Judul lengkap di tab browser & hasil cari Google.
NEXT_PUBLIC_NAMA_APLIKASI="Sistem Absensi QR Perangkat Desa Pekik Nyaring"
# Nama desa — muncul di header, login, footer, dan kartu QR
NEXT_PUBLIC_NAMA_DESA="Pekik Nyaring"
# Wilayah administratif
NEXT_PUBLIC_KECAMATAN="Pondok Kelapa"
NEXT_PUBLIC_KABUPATEN="Bengkulu Tengah"
# Nama lembaga pada kartu QR & footer
NEXT_PUBLIC_NAMA_PEMERINTAH="Pemerintah Desa Pekik Nyaring"
# Logo: taruh file di folder public/ lalu isi path-nya, mis. /logo-desa.png
NEXT_PUBLIC_LOGO="/logo-kabupaten-bengkulu-tengah.png"

# ---------- DOMAIN ----------
# Domain publik tanpa https:// — dipakai untuk metadata/canonical.
# Kosongkan bila belum punya domain (aplikasi tetap jalan normal).
NEXT_PUBLIC_DOMAIN=""

# ---------- KEAMANAN ----------
# Kunci tanda tangan token login. WAJIB diganti teks acak panjang saat deploy
# publik (mis. hasil: openssl rand -hex 32)
AUTH_SECRET="ganti-dengan-teks-acak-panjang"

# ---------- AKUN ADMIN AWAL (untuk npm run db:seed) ----------
# Hanya dipakai saat membuat akun admin pertama kali di database kosong
ADMIN_USERNAME="admindesapekiknyaring"
ADMIN_PASSWORD="admindesa123"
ADMIN_NAMA="Admin Desa Pekik Nyaring"
